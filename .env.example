# Lokal dev: shared backend on the local network, through the Vite proxy.
# Put these in .env.development.local and restart `yarn dev`:
# VITE_API_URL=http://localhost:5173
# VITE_API_PROXY_TARGET=http://192.168.0.84:8082
# VITE_SERVICES_API_URL=http://localhost:5173/services
# VITE_SERVICES_PROXY_TARGET=https://test.cirns.uz
VITE_API_PROXY_TARGET=
VITE_SERVICES_PROXY_TARGET=
